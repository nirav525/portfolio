---
// Astro needs statically analysable imports to hydrate an island, so demos are
// mounted here by name rather than resolved through a component map.
// To add a demo: import it, add a `case`, and register the title in registry.ts.
import DispatchDemo from './DispatchDemo';
import OutreachPipeline from './OutreachPipeline';
import OctoOpsMockup from './OctoOpsMockup';
import SpreadsheetMockup from './SpreadsheetMockup';
import MealPlanner from './MealPlanner';
import LiftLog from './LiftLog';
import MarketScore from './MarketScore';

interface Props { name: string }
const { name } = Astro.props;
const [base, variant] = name.split(':');
---
{base === 'dispatch' && <DispatchDemo client:visible />}
{base === 'outreach' && <OutreachPipeline client:visible />}
{base === 'platform' && <OctoOpsMockup client:visible initialPage={variant as any} />}
{base === 'sheet' && <SpreadsheetMockup client:visible variant={variant as any} />}
{base === 'mealplanner' && <MealPlanner client:visible />}
{base === 'liftlog' && <LiftLog client:visible />}
{base === 'marketscore' && <MarketScore client:visible />}
