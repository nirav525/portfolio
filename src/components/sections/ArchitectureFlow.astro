---
interface Props { steps: string[]; label?: string }
const { steps, label = 'System flow' } = Astro.props;
---
{steps.length > 0 && (
<figure class="flow" aria-label={label}>
  <ol>
    {steps.map((s) => (
      <li><span class="node">{s}</span></li>
    ))}
  </ol>
</figure>
)}

<style>
  .flow { margin: 2rem 0; max-width: var(--measure); }
  ol {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.4rem;
  }
  li { display: flex; align-items: center; gap: 0.4rem; }
  li:not(:last-child)::after {
    content: ''; width: 1.05rem; height: 1px; background: var(--rule-strong); flex: none;
  }
  .node {
    display: inline-flex; align-items: center;
    border: 1px solid var(--rule-strong); background: var(--paper);
    padding: 0.42rem 0.7rem; font-size: var(--step--1);
    line-height: 1.3; color: var(--ink);
  }
  @media (max-width: 40rem) {
    ol { flex-direction: column; align-items: stretch; }
    li { flex-direction: column; align-items: stretch; }
    li:not(:last-child)::after { width: 1px; height: 0.7rem; margin-left: 1.1rem; }
    .node { justify-content: flex-start; }
  }
</style>
