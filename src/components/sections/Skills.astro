---
// Grouped the way the resume groups them. Planning stays its own group so the
// supply chain work is as easy to find as the AI work.
const groups = [
  { name: 'AI & engineering', items: ['Claude Code', 'Claude API', 'Cursor', 'MCP', 'LLM integration', 'Agentic workflows', 'Python', 'SQL (PostgreSQL)', 'TypeScript'] },
  { name: 'Integrations', items: ['REST APIs', 'Gmail API', 'Slack bots', 'Traccar', 'Apollo.io', 'Resend', 'Google Places', 'FDA / USDA feeds', 'Google Apps Script'] },
  { name: 'Deployment', items: ['Requirements & workflow design', 'Pilots & rollouts', 'User adoption & training', 'Stakeholder management', 'SLA monitoring', 'Root-cause debugging', 'Human-in-the-loop guardrails'] },
  { name: 'Planning & optimization', items: ['Demand forecasting', 'S&OP / IBP', 'Inventory optimization', 'Google OR-Tools', 'Route optimization (VRP)', 'Scenario modeling'] },
  { name: 'Data & reporting', items: ['KPI design', 'Executive reporting', 'Tableau', 'Power BI', 'Advanced Excel'] },
];
---

<section class="skills" aria-label="Skills">
  <div class="shell">
    <h2>What I work with</h2>
    <div class="groups">
      {groups.map((g) => (
        <div class="group">
          <h3>{g.name}</h3>
          <ul>{g.items.map((s) => <li>{s}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills { margin-top: 6rem; }
  h2 { font-size: var(--step-2); letter-spacing: -0.03em; margin-bottom: 1.5rem; }
  .groups {
    display: grid; gap: 1.75rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
  }
  h3 {
    margin: 0 0 0.7rem; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--slate);
  }
  ul { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  li {
    padding: 0.42rem 0.9rem; border-radius: 999px; font-size: 0.88rem; font-weight: 500;
    background: #fff; border: 1px solid var(--rule); color: var(--ink);
    box-shadow: 0 6px 14px -10px rgba(20, 32, 42, 0.35);
  }
</style>
