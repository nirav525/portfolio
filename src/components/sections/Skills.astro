---
// Straight from the resume's skills section, split across two drifting rows.
const rowA = ['Agentic AI', 'LLM integration', 'Claude API', 'Workflow automation', 'API integrations', 'ERP architecture', 'Python', 'SQL', 'Google OR-Tools', 'Google Apps Script'];
const rowB = ['Route optimization', 'Demand forecasting', 'Inventory optimization', 'S&OP / IBP', 'Scenario analysis', 'KPI development', 'Executive reporting', 'Power BI', 'Tableau', 'Advanced Excel'];
---

<section class="skills" aria-label="Skills">
  <div class="shell"><h2>What I work with</h2></div>
  {[rowA, rowB].map((row, i) => (
    <div class={`marquee ${i ? 'rev' : ''}`}>
      <ul class="track">
        {[...row, ...row].map((s, k) => <li aria-hidden={k >= row.length ? 'true' : undefined}>{s}</li>)}
      </ul>
    </div>
  ))}
</section>

<style>
  .skills { margin-top: 6rem; overflow: hidden; }
  h2 { font-size: var(--step-2); letter-spacing: -0.03em; margin-bottom: 1.5rem; }
  .marquee { overflow: hidden; padding-block: 0.4rem; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; gap: 0.75rem; width: max-content; margin: 0; padding: 0; list-style: none; animation: drift 38s linear infinite; }
  .rev .track { animation-direction: reverse; animation-duration: 44s; }
  .marquee:hover .track { animation-play-state: paused; }
  li {
    white-space: nowrap; padding: 0.55rem 1.1rem; border-radius: 999px; font-size: 0.92rem; font-weight: 500;
    background: #fff; border: 1px solid var(--rule); color: var(--ink);
    box-shadow: 0 6px 14px -10px rgba(20, 32, 42, 0.35);
  }
  @keyframes drift { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; width: auto; padding-inline: var(--gutter); }
    .track li[aria-hidden='true'] { display: none; }
    .marquee { mask-image: none; -webkit-mask-image: none; }
  }
</style>
