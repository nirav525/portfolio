---
interface Metric {
  label: string; before?: string; after?: string; value?: string;
  delta?: string; emphasis?: boolean;
}
interface Props { metrics: Metric[] }
const { metrics } = Astro.props;
---
{metrics.length > 0 && (
<ul class="tiles">
  {metrics.map((m, i) => (
    <li class={`tile rise${m.emphasis ? ' em' : ''}`} style={`--d:${Math.min(i,7)*50}ms`}>
      <span class="v">{m.after ?? m.value ?? '—'}</span>
      {m.before && <span class="from">from {m.before}</span>}
      <span class="l">{m.label}</span>
      {m.delta && m.delta !== 'flat' && <span class="d">{m.delta}</span>}
    </li>
  ))}
</ul>
)}

<style>
  .tiles {
    list-style: none; margin: 1.5rem 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 0.75rem;
  }
  .tile {
    position: relative; padding: 1.1rem 1rem 1rem;
    background: #fff; border: 1px solid var(--rule);
    border-left: 3px solid color-mix(in srgb, var(--cat, var(--signal)) 40%, var(--rule));
    display: grid; align-content: start; gap: 0.12rem;
  }
  .tile.em { border-left-color: var(--cat, var(--signal)); }
  .v {
    font-size: 1.75rem; font-weight: 700; letter-spacing: -0.035em;
    line-height: 1.05; font-variant-numeric: tabular-nums;
    color: var(--cat, var(--ink));
  }
  .from { font-size: 0.76rem; color: var(--slate-soft); }
  .l { font-size: var(--step--1); color: var(--slate); line-height: 1.4; margin-top: 0.4rem; }
  .d {
    position: absolute; top: 0.9rem; right: 0.9rem;
    font-size: 0.74rem; font-weight: 600; color: var(--cat, var(--signal));
    background: color-mix(in srgb, var(--cat, var(--signal)) 10%, #fff);
    padding: 0.12rem 0.4rem;
  }
</style>
