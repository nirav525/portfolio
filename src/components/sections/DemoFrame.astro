---
interface Props { title: string; note?: string; synthetic?: boolean }
const { title, note, synthetic = true } = Astro.props;
---
<section class="demo">
  <div class="head">
    <h2>{title}</h2>
    {synthetic && <span class="badge">Illustrative — synthetic data</span>}
  </div>
  <div class="stage"><slot /></div>
  {note && <p class="note">{note}</p>}
</section>

<style>
  .demo { margin: 3rem 0; }
  .head {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 0.6rem; padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  h2 { font-size: var(--step-1); }
  .badge {
    font-size: var(--step--1); color: var(--amber);
    background: var(--amber-soft); padding: 0.22rem 0.55rem; border-radius: 2px;
  }
  .stage { margin-top: 1.5rem; }
  .note {
    margin-top: 1rem; font-size: var(--step--1); color: var(--slate-soft);
    max-width: var(--measure); line-height: 1.55;
  }
</style>
