---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;

const groups = [
  { key: 'featured', label: 'Featured work', blurb: 'The systems I built and ran at Crave Robotics, and the planning infrastructure behind them.', tier: 1 },
  { key: 'more', label: 'More professional work', blurb: 'Forecasting, planning, and assortment work with measured results.', tier: 2 },
  { key: 'own', label: 'Built on my own time', blurb: 'Small tools for my own problems. Same habit, lower stakes.', tier: 3 },
]
  .map((g) => ({ ...g, items: projects.filter((p) => p.data.tier === g.tier) }))
  .filter((g) => g.items.length > 0);

// Long figures ("11% → 4.8%", "Every weekday") need a smaller size to stay on one line.
const size = (v: string) => (v.length <= 6 ? 'big' : v.length <= 11 ? 'mid' : 'small');
---

<section class="catalog">
  {
    groups.map((g) => (
      <div class="section" data-section={g.key}>
        <div class="section-head">
          <h2 class="section-label">{g.label}</h2>
          <p class="section-blurb">{g.blurb}</p>
        </div>
        <ul class={`grid grid-${g.key}`}>
          {g.items.map((p, i) => (
            <li class="cell rise" style={`--d:${Math.min(i, 8) * 45}ms`}>
              <a
                href={`/projects/${p.id}`}
                class={`card ${g.tier === 1 ? 'card-featured' : ''}`}
                data-cat={p.data.category}
                style={p.data.accent ? `--cat:${p.data.accent}` : undefined}
              >
                <span class="tag">{p.data.category}</span>

                <span class={`figure ${size(p.data.headline.value)}`} data-count={p.data.headline.value}>
                  {p.data.headline.value}
                </span>
                <span class="figure-label">{p.data.headline.label}</span>

                <span class="name">{p.data.title}</span>
                {g.tier === 1 && <span class="summary">{p.data.summary}</span>}

                <span class="foot">
                  <span class="org">{p.data.org}</span>
                  {p.data.demo && <span class="live">Interactive</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<script>
  // Count the numeric headline figures up when they first appear.
  const figures = document.querySelectorAll<HTMLElement>('.figure');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const raw = el.dataset.count ?? '';
        // Only animate a plain "prefix + number + suffix" figure, never an arrow or range.
        if (/→/.test(raw)) return;
        const m = raw.match(/^(\D*)(\d[\d,.]*)(.*)$/);
        if (!m) return;
        const target = parseFloat(m[2].replace(/,/g, ''));
        if (!isFinite(target) || target > 100000) return;
        const dp = m[2].includes('.') ? 1 : 0;
        const start = performance.now();
        const dur = 900;
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          const v = (target * eased).toFixed(dp);
          el.textContent = `${m[1]}${Number(v).toLocaleString()}${m[3]}`;
          if (t < 1) requestAnimationFrame(tick);
        };
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          requestAnimationFrame(tick);
        }
      });
    },
    { threshold: 0.4 },
  );
  figures.forEach((f) => io.observe(f));
</script>

<style>
  .catalog { margin-top: 0.5rem; }

  .section + .section { margin-top: 3.25rem; }
  .section-head { margin-bottom: 1.15rem; }
  .section-label {
    font-size: var(--step-1); font-weight: 650; letter-spacing: -0.02em;
    color: var(--ink); margin: 0;
  }
  .section-blurb { margin: 0.25rem 0 0; color: var(--slate); font-size: var(--step--1); max-width: 52ch; }

  .grid {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr));
  }
  .grid-featured {
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 0.3rem;
    height: 100%;
    padding: 1.4rem 1.25rem 1.15rem;
    background: linear-gradient(165deg, color-mix(in srgb, var(--cat) 6%, #fff), #fff 55%);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--cat);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s;
  }
  .card::after {
    content: ''; position: absolute; inset: 0; background: var(--cat);
    opacity: 0; transition: opacity 0.18s ease; pointer-events: none;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px -14px color-mix(in srgb, var(--cat) 60%, transparent);
    border-color: color-mix(in srgb, var(--cat) 35%, var(--rule));
  }
  .card:hover::after { opacity: 0.04; }

  .card-featured {
    grid-template-rows: auto auto auto auto 1fr auto;
    padding: 1.75rem 1.6rem 1.4rem;
    border-top-width: 4px;
    background: linear-gradient(165deg, color-mix(in srgb, var(--cat) 11%, #fff), #fff 60%);
  }
  .card-featured .name { font-size: 1.18rem; }
  .card-featured .summary {
    font-size: 0.88rem; line-height: 1.5; color: var(--slate);
    margin-top: 0.3rem; max-width: 42ch;
  }

  .tag { font-size: 0.72rem; font-weight: 500; letter-spacing: 0.01em; color: var(--cat); margin-bottom: 0.6rem; }

  .figure {
    font-weight: 700; letter-spacing: -0.04em; line-height: 1.05;
    color: var(--cat); font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .figure.big { font-size: 2.6rem; }
  .figure.mid { font-size: 2.05rem; }
  .figure.small { font-size: 1.6rem; }
  .card-featured .figure.big { font-size: 3.1rem; }
  .card-featured .figure.mid { font-size: 2.3rem; }
  .card-featured .figure.small { font-size: 1.9rem; }

  .figure-label { font-size: var(--step--1); color: var(--slate); line-height: 1.35; margin-bottom: 1rem; }

  .name {
    font-size: 1.02rem; font-weight: 600; letter-spacing: -0.018em;
    line-height: 1.3; color: var(--ink); align-self: start;
  }

  .foot {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    margin-top: 1.1rem; padding-top: 0.8rem; border-top: 1px solid var(--rule);
    font-size: 0.78rem; color: var(--slate-soft);
  }
  .live { color: var(--cat); font-weight: 500; display: inline-flex; align-items: center; gap: 0.35rem; }
  .live::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
</style>
