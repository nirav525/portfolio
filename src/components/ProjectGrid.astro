---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
const categories = [...new Set(projects.map((p) => p.data.category))].sort();
const featured = projects.filter((p) => p.data.tier === 1);
const rest = projects.filter((p) => p.data.tier !== 1);
---

<section class="catalog">
  <div class="filters" role="group" aria-label="Filter projects by category">
    <button class="chip is-active" data-filter="all" aria-pressed="true">Everything</button>
    {
      categories.map((c) => (
        <button class="chip" data-filter={c} data-cat={c} aria-pressed="false">
          <i />
          {c}
        </button>
      ))
    }
  </div>

  {featured.length > 0 && (
    <div class="section" data-section="featured">
      <h2 class="section-label">Featured</h2>
      <ul class="grid grid-featured">
        {
          featured.map((p, i) => (
            <li class="cell rise" data-category={p.data.category} style={`--d:${Math.min(i, 8) * 45}ms`}>
              <a href={`/projects/${p.id}`} class="card card-featured" data-cat={p.data.category} style={p.data.accent ? `--cat:${p.data.accent}` : undefined}>
                <span class="tag">{p.data.category}</span>

                <span class="figure" data-count={p.data.headline.value}>
                  {p.data.headline.value}
                </span>
                <span class="figure-label">{p.data.headline.label}</span>

                <span class="name">{p.data.title}</span>
                <span class="summary">{p.data.summary}</span>

                <span class="foot">
                  <span class="org">{p.data.org}</span>
                  {p.data.demo && <span class="live">Interactive</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  )}

  {rest.length > 0 && (
    <div class="section" data-section="rest">
      <h2 class="section-label">More work</h2>
      <ul class="grid">
        {
          rest.map((p, i) => (
            <li class="cell rise" data-category={p.data.category} style={`--d:${Math.min(i, 8) * 45}ms`}>
              <a href={`/projects/${p.id}`} class="card" data-cat={p.data.category} style={p.data.accent ? `--cat:${p.data.accent}` : undefined}>
                <span class="tag">{p.data.category}</span>

                <span class="figure" data-count={p.data.headline.value}>
                  {p.data.headline.value}
                </span>
                <span class="figure-label">{p.data.headline.label}</span>

                <span class="name">{p.data.title}</span>

                <span class="foot">
                  <span class="org">{p.data.org}</span>
                  {p.data.demo && <span class="live">Interactive</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  )}

  <p class="empty" hidden>Nothing in that category yet.</p>
</section>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const sections = document.querySelectorAll<HTMLDivElement>('.section');
  const empty = document.querySelector<HTMLParagraphElement>('.empty');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', String(on));
      });
      let shown = 0;
      sections.forEach((section) => {
        let shownInSection = 0;
        section.querySelectorAll<HTMLLIElement>('.cell').forEach((cell) => {
          const match = filter === 'all' || cell.dataset.category === filter;
          cell.hidden = !match;
          if (match) {
            shown++;
            shownInSection++;
            // Replay the entrance so filtering feels like a deal, not a repaint.
            cell.style.setProperty('--d', `${Math.min(shownInSection, 8) * 35}ms`);
            cell.classList.remove('rise');
            void cell.offsetWidth;
            cell.classList.add('rise');
          }
        });
        section.hidden = shownInSection === 0;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });

  // Count the numeric headline figures up when they first appear.
  const figures = document.querySelectorAll<HTMLElement>('.figure');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const raw = el.dataset.count ?? '';
        const m = raw.match(/^(\D*)(\d[\d,.]*)(.*)$/);
        if (!m) return;
        const target = parseFloat(m[2].replace(/,/g, ''));
        if (!isFinite(target) || target > 100000) return;
        const dp = m[2].includes('.') ? 1 : 0;
        const start = performance.now();
        const dur = 900;
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          const v = (target * eased).toFixed(dp);
          el.textContent = `${m[1]}${Number(v).toLocaleString()}${m[3]}`;
          if (t < 1) requestAnimationFrame(tick);
        };
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          requestAnimationFrame(tick);
        }
      });
    },
    { threshold: 0.4 },
  );
  figures.forEach((f) => io.observe(f));
</script>

<style>
  .catalog { margin-top: 2.5rem; }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2rem;
  }
  .chip {
    font: inherit;
    font-size: var(--step--1);
    color: var(--slate);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.36rem 0.85rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .chip i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cat, var(--slate-soft));
  }
  .chip:hover { color: var(--ink); border-color: var(--rule-strong); }
  .chip.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .section-label {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--slate-soft); margin: 0 0 1rem;
  }
  .section + .section { margin-top: 2.75rem; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr));
    gap: 1rem;
  }
  .grid-featured {
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 0.3rem;
    height: 100%;
    padding: 1.4rem 1.25rem 1.15rem;
    background: linear-gradient(165deg, color-mix(in srgb, var(--cat) 6%, #fff), #fff 55%);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--cat);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s;
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cat);
    opacity: 0;
    transition: opacity 0.18s ease;
    pointer-events: none;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px -14px color-mix(in srgb, var(--cat) 60%, transparent);
    border-color: color-mix(in srgb, var(--cat) 35%, var(--rule));
  }
  .card:hover::after { opacity: 0.04; }

  .card-featured {
    grid-template-rows: auto auto auto auto 1fr auto;
    padding: 1.75rem 1.6rem 1.4rem;
    border-top-width: 4px;
    background: linear-gradient(165deg, color-mix(in srgb, var(--cat) 11%, #fff), #fff 60%);
  }
  .card-featured .figure { font-size: clamp(2.4rem, 6vw, 3.1rem); }
  .card-featured .name { font-size: 1.18rem; }
  .card-featured .summary {
    font-size: 0.88rem; line-height: 1.5; color: var(--slate);
    margin-top: 0.3rem; max-width: 42ch;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--cat);
    margin-bottom: 0.6rem;
  }

  .figure {
    font-size: clamp(2.1rem, 5.5vw, 2.7rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--cat);
    font-variant-numeric: tabular-nums;
  }
  .figure-label {
    font-size: var(--step--1);
    color: var(--slate);
    line-height: 1.35;
    margin-bottom: 1rem;
  }

  .name {
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.3;
    color: var(--ink);
    align-self: start;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 1.1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule);
    font-size: 0.78rem;
    color: var(--slate-soft);
  }
  .live {
    color: var(--cat);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .live::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .empty { padding: 3rem 0; color: var(--slate); }
</style>
