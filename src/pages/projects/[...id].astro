---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MetricTiles from '../../components/sections/MetricTiles.astro';
import ArchitectureFlow from '../../components/sections/ArchitectureFlow.astro';
import DemoFrame from '../../components/sections/DemoFrame.astro';
import DemoMount from '../../components/demos/DemoMount.astro';
import { demoTitles, demoCues, isDemoKey, baseDemoKey } from '../../components/demos/registry';
import '../../styles/demos.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const sorted = projects.sort(
    (a, b) => a.data.tier - b.data.tier || a.data.order - b.data.order,
  );
  return sorted.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, index: i + 1, total: sorted.length, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
}

const { entry, index, total, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const demoBase = baseDemoKey(d.demo) as keyof typeof demoTitles | undefined;
const demoTitle = isDemoKey(d.demo) && demoBase ? demoTitles[demoBase] : null;

const disclosureCopy: Record<string, string> = {
  A: '',
  B: 'Described without confidential information. The demo and any figures inside it use synthetic data.',
  C: 'Specifics cannot be disclosed. Counterparties, commercial terms, and exact amounts are withheld. The process and reasoning are accurate.',
};
---

<Base title={`${d.title} — Nirav`} description={d.summary} path={`/projects/${entry.id}`}>
  <article data-cat={d.category}>
    <header class="band">
      <div class="shell band-inner">
        <div class="band-text">
          <a href="/" class="back">&larr; All projects</a>
          <div class="tagrow reveal">
            <p class="tag"><i></i>{d.category}</p>
            <p class="case">Case {String(index).padStart(2, '0')} / {String(total).padStart(2, '0')}</p>
          </div>
          <h1 class="reveal" style="--d:70ms">{d.title}</h1>
          <p class="summary reveal" style="--d:140ms">{d.summary}</p>
          <p class="who reveal" style="--d:200ms">{d.org} &middot; {d.period} &middot; {d.role}</p>

          {d.tldr.length > 0 && (
            <ul class="tldr">
              {d.tldr.map((t, i) => (
                <li class="reveal" style={`--d:${260 + i * 70}ms`}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.25" /><path d="M4.8 8.3l2.1 2.1 4.3-4.3" /></svg>
                  {t}
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="headline-stat reveal" style="--d:180ms">
          <span class="hs-value">{d.headline.value}</span>
          <span class="hs-label">{d.headline.label}</span>
        </div>
      </div>
    </header>

    <div class="shell">
      {d.metrics.length > 0 && (
        <section class="block reveal">
          <h2>The numbers</h2>
          <MetricTiles metrics={d.metrics} />
        </section>
      )}

      {d.stack.length > 0 && (
        <ul class="stack reveal">{d.stack.map((s) => <li>{s}</li>)}</ul>
      )}

      {demoTitle && (
        <DemoFrame title={demoTitle} note={d.demoNote} cue={demoBase ? demoCues[demoBase] : undefined}>
          <DemoMount name={d.demo!} />
        </DemoFrame>
      )}

      {d.architecture.length > 0 && (
        <section class="block">
          <h2>How it fits together</h2>
          <ArchitectureFlow steps={d.architecture} />
        </section>
      )}

      <details class="story reveal">
        <summary>
          <span class="chev" aria-hidden="true"></span>
          <span class="open-label">Read the full case study</span>
          <span class="shut-label">Hide the case study</span>
        </summary>
        <div class="prose"><Content /></div>
      </details>

      <section class="reflect reveal">
        <div>
          <h3>What I learned</h3>
          <p>{d.learned}</p>
        </div>
        <div>
          <h3>What I would do next</h3>
          <p>{d.next}</p>
        </div>
      </section>

      {d.disclosure !== 'A' && (
        <p class="disclosure">{d.disclosureNote ?? disclosureCopy[d.disclosure]}</p>
      )}

      {d.links.length > 0 && (
        <section class="block">
          <h2>Links</h2>
          <ul class="links">{d.links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}</ul>
        </section>
      )}

      {import.meta.env.DEV && d.todo.length > 0 && (
        <aside class="todo">
          <h2>Unresolved — dev only, never in production</h2>
          <ul>{d.todo.map((t) => <li>{t}</li>)}</ul>
        </aside>
      )}

      <nav class="pager" aria-label="Other projects">
        {prev ? (
          <a href={`/projects/${prev.id}`} data-cat={prev.data.category}>
            <span>&larr; Previous</span><strong>{prev.data.title}</strong>
          </a>
        ) : <span />}
        {next && (
          <a href={`/projects/${next.id}`} class="nx" data-cat={next.data.category}>
            <span>Next &rarr;</span><strong>{next.data.title}</strong>
          </a>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .band {
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--cat) 9%, #fff),
      color-mix(in srgb, var(--cat) 3%, var(--paper)));
    border-bottom: 1px solid color-mix(in srgb, var(--cat) 22%, var(--rule));
    border-top: 3px solid var(--cat);
    padding-block: clamp(2rem, 5vw, 3.25rem) clamp(2rem, 5vw, 3rem);
  }
  .band-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(13rem, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .band-text { max-width: 44rem; }
  .headline-stat {
    justify-self: end;
    text-align: right;
    padding: 1.5rem 0 1.5rem 1.75rem;
    border-left: 1px solid color-mix(in srgb, var(--cat) 30%, var(--rule));
  }
  .hs-value {
    display: block;
    font-family: var(--font-prose);
    font-weight: 600;
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--cat);
    font-variant-numeric: tabular-nums;
  }
  .hs-label {
    display: block;
    margin-top: 0.85rem;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--slate);
    max-width: 20ch;
    margin-left: auto;
  }
  @media (max-width: 46rem) {
    .band-inner { grid-template-columns: 1fr; }
    .headline-stat {
      justify-self: start; text-align: left;
      border-left: none; border-top: 1px solid color-mix(in srgb, var(--cat) 30%, var(--rule));
      padding: 1.5rem 0 0; margin-top: 0.5rem;
    }
    .hs-label { margin-left: 0; }
  }
  .back {
    font-size: var(--step--1); color: var(--slate);
    text-decoration: none; display: inline-block; margin-bottom: 1.6rem;
  }
  .back:hover { color: var(--ink); text-decoration: underline; }

  .tagrow { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.9rem; }
  .tag { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; font-weight: 600; color: var(--cat); }
  .tag i { width: 7px; height: 7px; border-radius: 50%; background: var(--cat); }
  .case {
    font-family: var(--font-prose); font-style: italic;
    font-size: 0.85rem; color: var(--slate-soft);
    font-variant-numeric: tabular-nums;
  }

  h1 {
    font-family: var(--font-prose); font-weight: 600;
    font-size: clamp(2rem, 5.2vw, 3.1rem); letter-spacing: -0.015em; line-height: 1.08;
  }
  .summary {
    margin-top: 1rem; font-size: 1.1rem; line-height: 1.5;
    color: #33454f; max-width: 52ch;
  }
  .who { margin-top: 1.1rem; font-size: var(--step--1); color: var(--slate-soft); }

  .tldr {
    list-style: none; margin: 2.1rem 0 0; padding: 0;
    display: grid; gap: 0.55rem; max-width: 58ch;
  }
  .tldr li {
    display: flex; align-items: flex-start; gap: 0.6rem;
    font-size: 1rem; line-height: 1.5; color: #22323d;
  }
  .tldr svg {
    width: 17px; height: 17px; flex: none; margin-top: 0.15em;
    fill: none; stroke: var(--cat); stroke-width: 1.4;
  }
  .tldr svg circle { fill: color-mix(in srgb, var(--cat) 10%, transparent); }
  .tldr svg path { stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .stack {
    display: flex; flex-wrap: wrap; gap: 0.35rem;
    list-style: none; margin: 1.75rem 0 0; padding: 0;
    font-size: 0.78rem; color: var(--slate);
  }
  .stack li {
    border: 1px solid var(--rule); border-radius: 999px;
    padding: 0.22rem 0.6rem; background: #fff;
  }

  .block { margin-top: 3rem; }
  .block > h2 {
    font-size: var(--step-1); padding-bottom: 0.75rem;
    border-bottom: 2px solid color-mix(in srgb, var(--cat) 30%, var(--rule));
  }

  .story {
    margin-top: 3rem; border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .story summary {
    cursor: pointer; list-style: none; padding: 1.1rem 0;
    font-weight: 600; color: var(--cat);
    display: flex; align-items: center; gap: 0.5rem;
  }
  .story summary::-webkit-details-marker { display: none; }
  .story summary::before {
    content: ''; width: 9px; height: 9px; flex: none;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.2s ease;
  }
  .story[open] summary::before { transform: rotate(-135deg) translate(-3px, -3px); }
  .story .shut-label, .story[open] .open-label { display: none; }
  .story[open] .shut-label { display: inline; }
  .story .prose { padding-bottom: 2.5rem; }

  .reflect {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 2rem; margin-top: 3rem;
  }
  .reflect h3 {
    font-size: var(--step-0); color: var(--cat); margin-bottom: 0.6rem;
  }
  .reflect p {
    font-family: var(--font-prose); font-size: 1.02rem;
    line-height: 1.62; color: #2a3a46;
  }

  .disclosure {
    margin-top: 2.75rem; padding: 0.75rem 1rem;
    background: var(--paper-sunk); border-left: 2px solid var(--rule-strong);
    font-size: var(--step--1); color: var(--slate);
    max-width: var(--measure); line-height: 1.55;
  }

  .links { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  .links a { color: var(--cat); }

  .todo {
    margin-top: 3rem; padding: 1rem 1.2rem;
    background: var(--amber-soft); border: 1px dashed var(--amber);
    color: var(--amber); max-width: var(--measure);
  }
  .todo h2 { font-size: var(--step--1); font-weight: 600; }
  .todo ul { margin: 0.6rem 0 0; padding-left: 1.1rem; font-size: var(--step--1); line-height: 1.55; }

  .pager {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
    margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--rule);
    margin-bottom: 2rem;
  }
  .pager a {
    text-decoration: none; display: grid; gap: 0.2rem;
    padding: 1rem; border: 1px solid var(--rule);
    border-top: 2px solid var(--cat); background: #fff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .pager a:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -14px color-mix(in srgb, var(--cat) 70%, transparent);
  }
  .pager .nx { text-align: right; }
  .pager span { font-size: 0.76rem; color: var(--slate-soft); }
  .pager strong { font-weight: 600; letter-spacing: -0.015em; font-size: 0.96rem; }

  @media (max-width: 34rem) {
    .pager { grid-template-columns: 1fr; }
    .pager .nx { text-align: left; }
  }
</style>
