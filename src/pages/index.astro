---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.tier - b.data.tier || a.data.order - b.data.order,
);
const demoCount = projects.filter((p) => p.data.demo).length;

// Hero animation geometry: a depot, three technician loops, clustered stops.
const ROUTES = [
  'M300,150 L168,86 L104,132 L142,196 L228,206 Z',
  'M300,150 L392,74 L470,104 L452,178 L376,164 Z',
  'M300,150 L246,244 L318,286 L404,252 L386,190 Z',
];
const STOPS = [
  [168, 86], [104, 132], [142, 196], [228, 206],
  [392, 74], [470, 104], [452, 178], [376, 164],
  [246, 244], [318, 286], [404, 252], [386, 190],
];
---

<Base
  title="Nirav — Proof of work"
  description="Operating systems, optimization tools, and internal platforms I have built, shipped, and run. Twelve projects with interactive demos on synthetic data."
  path="/"
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <svg viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice">
        {ROUTES.map((d, i) => <path class="route" d={d} style={`--i:${i}`} />)}
        {STOPS.map(([x, y], i) => <circle class="stop" cx={x} cy={y} r="4" style={`--i:${i}`} />)}
        <rect class="depot" x="293" y="143" width="14" height="14" />
      </svg>
    </div>

    <div class="shell hero-inner">
      <p class="kicker rise">Strategy and operations, built rather than presented</p>
      <h1 class="rise" style="--d:80ms">I find the expensive problem, then build the thing that fixes it.</h1>
      <p class="sub rise" style="--d:160ms">
        Twelve projects. Real numbers. {demoCount} of them you can click and run yourself.
      </p>

      <dl class="stats rise" style="--d:240ms">
        <div><dt>Fleet growth absorbed at flat headcount</dt><dd>67%</dd></div>
        <div><dt>Savings from forecasting work</dt><dd>$3M+</dd></div>
        <div><dt>Annual SaaS spend consolidated</dt><dd>$100K+</dd></div>
      </dl>
    </div>
  </section>

  <div class="shell">
    <ProjectGrid projects={projects} />
  </div>
</Base>

<style>
  .hero {
    position: relative; background: #0e1a24; color: #f4f7f6;
    overflow: hidden; padding-block: clamp(3.5rem, 10vw, 6.5rem);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .hero-bg { position: absolute; inset: 0; opacity: 0.5; }
  .hero-bg svg { width: 100%; height: 100%; }
  .hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(105deg, #0e1a24 32%, rgba(14,26,36,0.55) 100%);
  }
  .route {
    fill: none; stroke: #2ec4a6; stroke-width: 1.4;
    stroke-dasharray: 900; stroke-dashoffset: 900;
    animation: draw 2.4s cubic-bezier(0.4,0,0.2,1) forwards;
    animation-delay: calc(var(--i) * 320ms + 200ms); opacity: 0.85;
  }
  .stop {
    fill: #2ec4a6; opacity: 0;
    animation: pop 0.4s ease forwards;
    animation-delay: calc(var(--i) * 110ms + 700ms);
  }
  .depot { fill: #f4f7f6; opacity: 0.9; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes pop { to { opacity: 0.95; } }
  @media (prefers-reduced-motion: reduce) {
    .route { animation: none; stroke-dashoffset: 0; }
    .stop { animation: none; opacity: 0.95; }
  }

  .hero-inner { position: relative; max-width: 46rem; }
  .kicker { font-size: var(--step--1); color: #2ec4a6; margin-bottom: 1.1rem; font-weight: 500; }
  h1 {
    font-size: clamp(2.1rem, 6vw, 3.5rem); letter-spacing: -0.035em;
    line-height: 1.06; max-width: 17ch;
  }
  .sub {
    margin-top: 1.35rem; font-size: 1.08rem; color: #a9bcc7;
    max-width: 42ch; line-height: 1.55;
  }
  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1.5rem 2rem; margin: 2.75rem 0 0; padding-top: 1.75rem;
    border-top: 1px solid rgba(244,247,246,0.16); max-width: 40rem;
  }
  .stats dt { font-size: 0.78rem; color: #8aa2b0; line-height: 1.35; margin-bottom: 0.35rem; }
  .stats dd {
    margin: 0; font-size: clamp(1.6rem, 4vw, 2.05rem); font-weight: 700;
    letter-spacing: -0.035em; line-height: 1; font-variant-numeric: tabular-nums;
  }
</style>
