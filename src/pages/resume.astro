---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ROLES } from '../content.config';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.tier - b.data.tier || a.data.order - b.data.order,
);

const KINDS = [
  ['headline', 'Headline'],
  ['quantified', 'Quantified impact'],
  ['technical', 'Technical signal'],
  ['strategy', 'Strategy and operations signal'],
  ['ownership', 'Ownership signal'],
] as const;

// Fit score per project per role, used for filtering and ordering.
const rows = projects.map((p) => ({
  id: p.id,
  title: p.data.title,
  org: p.data.org,
  fit: p.data.roleFit as Record<string, number>,
  bullets: KINDS.map(([key, label]) => ({
    label,
    text: (p.data.bullets as Record<string, string | undefined>)[key],
  })).filter((b) => b.text),
}));
---

<Base
  title="Resume source material — Nirav"
  description="Resume bullets generated from the project catalog, filterable by target role."
  path="/resume"
>
  <div class="shell">
    <header class="head">
      <h1>Resume source material</h1>
      <p class="lede">
        Every bullet below is drawn from a project in the catalog and links back
        to the evidence for it. Filter by the role you are hiring for and the
        list reorders by fit.
      </p>
    </header>

    <div class="filters" role="group" aria-label="Filter by target role">
      <button class="chip is-active" data-role="all" aria-pressed="true">All projects</button>
      {ROLES.map((r) => <button class="chip" data-role={r} aria-pressed="false">{r}</button>)}
    </div>

    <ol class="list">
      {rows.map((r) => (
        <li class="item" data-fit={JSON.stringify(r.fit)}>
          <div class="item-head">
            <h2><a href={`/projects/${r.id}`}>{r.title}</a></h2>
            <span class="org">{r.org}</span>
          </div>
          <dl>
            {r.bullets.map((b) => (
              <div>
                <dt>{b.label}</dt>
                <dd>{b.text}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ol>
    <p class="empty" hidden>No projects rank for that role yet.</p>
  </div>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-role]');
  const list = document.querySelector<HTMLOListElement>('.list')!;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.item'));
  const empty = document.querySelector<HTMLParagraphElement>('.empty');
  const original = [...items];

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const role = chip.dataset.role!;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', String(on));
      });

      if (role === 'all') {
        original.forEach((el) => {
          el.hidden = false;
          list.appendChild(el);
        });
        if (empty) empty.hidden = true;
        return;
      }

      const scored = original.map((el) => ({
        el,
        score: (JSON.parse(el.dataset.fit || '{}')[role] as number) ?? 0,
      }));
      scored.sort((a, b) => b.score - a.score);
      scored.forEach(({ el, score }) => {
        el.hidden = score === 0;
        list.appendChild(el);
      });
      if (empty) empty.hidden = scored.some((s) => s.score > 0);
    });
  });
</script>

<style>
  .head { padding-top: clamp(2.5rem, 7vw, 5rem); max-width: 40rem; }
  h1 { font-size: var(--step-3); letter-spacing: -0.03em; }
  .lede {
    margin-top: 1.1rem; font-family: var(--font-prose);
    font-size: 1.08rem; line-height: 1.62; color: #2a3a46;
  }

  .filters {
    display: flex; flex-wrap: wrap; gap: 0.45rem;
    margin-top: 2.5rem; padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }
  .chip {
    font: inherit; font-size: var(--step--1); color: var(--slate);
    background: transparent; border: 1px solid var(--rule);
    border-radius: 999px; padding: 0.3rem 0.75rem; cursor: pointer;
    transition: color 0.12s, border-color 0.12s, background-color 0.12s;
  }
  .chip:hover { color: var(--ink); border-color: var(--rule-strong); }
  .chip.is-active { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  .list { list-style: none; margin: 0; padding: 0; }
  .item { padding: 2rem 0; border-bottom: 1px solid var(--rule); }
  .item-head {
    display: flex; align-items: baseline; gap: 0.85rem;
    flex-wrap: wrap; margin-bottom: 1.1rem;
  }
  h2 { font-size: var(--step-1); }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; }
  .org { font-size: var(--step--1); color: var(--slate-soft); }

  dl { margin: 0; display: grid; gap: 0.9rem; max-width: var(--measure); }
  dt { font-size: var(--step--1); color: var(--slate-soft); margin-bottom: 0.2rem; }
  dd { margin: 0; line-height: 1.55; }
  .empty { padding: 2.5rem 0; color: var(--slate); }
</style>
