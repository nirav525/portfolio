---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = '' } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const owner = 'Nirav';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <header class="masthead">
      <div class="shell masthead-inner">
        <a href="/" class="wordmark">{owner}<i>Proof of work</i></a>
        <nav aria-label="Primary">
          <a href="/">Catalog</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="shell footer-inner">
        <p>Built and maintained by {owner}. Source on GitHub.</p>
        <p class="footer-note">
          Project demos run on synthetic data and do not contain confidential
          information from any employer.
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 0.6rem 1rem;
    z-index: 50;
  }
  .skip:focus {
    left: 0;
  }
  .masthead {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--rule);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
  }
  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    font-size: var(--step-0);
    color: var(--ink);
  }
  .wordmark i {
    font-style: normal;
    font-family: var(--font-prose);
    font-style: italic;
    font-size: var(--step--1);
    color: var(--slate-soft);
  }
  nav {
    display: flex;
    gap: 1.4rem;
    font-size: var(--step--1);
  }
  nav a {
    color: var(--slate);
    text-decoration: none;
    padding-block: 0.25rem;
    transition: color 0.15s ease;
  }
  nav a:hover {
    color: var(--ink);
  }
  .footer {
    margin-top: 6rem;
    border-top: 1px solid var(--rule);
    padding-block: 2.25rem 3.5rem;
  }
  .footer-inner {
    display: grid;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--slate);
  }
  .footer-note {
    max-width: 46ch;
    color: var(--slate-soft);
  }
</style>
